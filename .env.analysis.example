# Server only. Copy to .env.analysis.local for `npm run analysis:dev`.
# On Vercel, set these without the VITE_ prefix. Never commit real values.
ANALYSIS_PUBLIC_ORIGIN=http://127.0.0.1:3001
ANALYSIS_TIMEZONE=Asia/Taipei
# Use a dedicated shiji_analysis_reader login (Supabase pooler username may append .PROJECT_REF).
# Password must be URL-encoded. TLS certificate validation is always enabled.
ANALYSIS_DATABASE_URL=postgresql://shiji_analysis_reader.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:6543/postgres
# Optional Supabase CA certificate PEM (literal \n is accepted).
# ANALYSIS_DATABASE_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# Generate separate client entries with `npm run analysis:token -- codex 90` (and claude-code).
ANALYSIS_CLIENTS_JSON='[{"id":"codex","token_sha256":"REPLACE_WITH_GENERATED_SHA256","expires_at":"2027-01-01T00:00:00Z"}]'
